    "check": "npm run typecheck && npm test"
  },
  "optionalDependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
