{
  "name": "nexus-agent",
  "version": "0.1.0",
  "description": "Hand your repository a list of changes: Nexus makes them in parallel lanes, checks and reviews every one, and keeps only what passes. Any language, any AI model.",
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "code-index",
    "tree-sitter",
    "agents-md",
    "agent-skills",
    "parallel-agents",
    "developer-tools"
  ],
  "homepage": "https://github.com/narinzar/nexus-agent#readme",
  "bugs": {
    "url": "https://github.com/narinzar/nexus-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narinzar/nexus-agent.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "nexus": "bin/nexus.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "nexus": "node src/cli.ts",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "optionalDependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
