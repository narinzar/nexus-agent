{
  "name": "nexus-agent",
  "version": "0.1.0",
  "description": "General-purpose, language-agnostic, provider-independent software-engineering agent with repository intelligence and a token-efficient context engine.",
  "type": "module",
  "license": "MIT",
  "bin": { "nexus": "bin/nexus.mjs" },
