# readlist reads its settings from the environment; it does not load .env itself.
# Copy what you need into your shell, e.g. `export READLIST_FILE=~/reading.json`.

# Path of the JSON file holding the reading list.
# Optional. Default: $XDG_DATA_HOME/readlist/readlist.json
#                   (~/.local/share/readlist/readlist.json when XDG_DATA_HOME is unset).
# The global --file option wins over this.
READLIST_FILE=
